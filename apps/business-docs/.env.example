PORT=3001
NODE_ENV=development

# Opcional: Ruta personalizada para Chromium (solo si no usas el bundled de Playwright)
# CHROMIUM_PATH=/usr/bin/chromium-browser

# Auth
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=12h

# Admin inicial (se siembra en migrate solo si no existe ningun usuario)
SEED_ADMIN_EMAIL=admin@arman.local
SEED_ADMIN_PASSWORD=admin123

# CORS: lista de origenes permitidos separada por coma. Vacio = todos (solo dev).
CORS_ORIGINS=

# ARCA (mock por defecto)
ARCA_MOCK=true
ARCA_CUIT=20999999991
ARCA_AMBIENTE=homologacion

# RunPod (dashboard /infra). Key de solo lectura: runpod.io -> Settings -> API Keys
RUNPOD_API_KEY=
# Alertas: horas de credito restantes y minutos de pod con GPU al 0% antes de avisar
RUNPOD_LOW_HOURS=24
RUNPOD_IDLE_ALERT_MIN=30
# Si se configura, las alertas se mandan a este mail (usa SMTP_*)
RUNPOD_ALERT_EMAIL=

# Vast.ai (dashboard /infra). Key de solo lectura: console.vast.ai -> Keys -> API Keys,
# con permisos instance_read, user_read y billing_read
VAST_API_KEY=
# Umbrales propios de Vast.ai; si quedan vacios usan los de RunPod
VAST_LOW_HOURS=
VAST_IDLE_ALERT_MIN=
# Mail para las alertas de GPU de los dos proveedores (si falta, usa RUNPOD_ALERT_EMAIL)
GPU_ALERT_EMAIL=

# TaskPilot (/taskpilot): tareas de Redmine. Las API keys se siembran en la base cifradas con
# TASKPILOT_SECRET (32 bytes hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Una cuenta por persona: REDMINE_SEED_<ALIAS>_LOGIN y REDMINE_SEED_<ALIAS>_API_KEY
# (la key sale de Redmine > Mi cuenta > Clave de acceso API > Mostrar).
REDMINE_URL=
REDMINE_SEED_SANTI_LOGIN=
REDMINE_SEED_SANTI_API_KEY=
REDMINE_SEED_GABI_LOGIN=
REDMINE_SEED_GABI_API_KEY=
TASKPILOT_SECRET=
# Cada cuantos minutos se sincroniza con Redmine (ademas del boton Sincronizar)
TASKPILOT_SYNC_MINUTES=45
# Paginas de 100 issues pedidas en paralelo a Redmine durante el sync (tarda 5-8 s por pagina)
REDMINE_PAGE_CONCURRENCY=3
# Traba de seguridad: TaskPilot solo LEE Redmine salvo que esto sea exactamente "true".
# Habilita cambiar estados y cargar horas desde TaskPilot (siempre con confirmacion del usuario).
REDMINE_ALLOW_WRITES=false
