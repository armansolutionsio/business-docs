PORT=3001
NODE_ENV=development

# Opcional: Ruta personalizada para Chromium (solo si no usas el bundled de Playwright)
# CHROMIUM_PATH=/usr/bin/chromium-browser

# Auth
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=12h

# Admin inicial (se siembra en migrate solo si no existe ningun usuario)
SEED_ADMIN_EMAIL=admin@arman.local
SEED_ADMIN_PASSWORD=admin123

# CORS: lista de origenes permitidos separada por coma. Vacio = todos (solo dev).
CORS_ORIGINS=

# ARCA (mock por defecto)
ARCA_MOCK=true
ARCA_CUIT=20999999991
ARCA_AMBIENTE=homologacion

# RunPod (dashboard /infra). Key de solo lectura: runpod.io -> Settings -> API Keys
RUNPOD_API_KEY=
# Alertas: horas de credito restantes y minutos de pod con GPU al 0% antes de avisar
RUNPOD_LOW_HOURS=24
RUNPOD_IDLE_ALERT_MIN=30
# Si se configura, las alertas se mandan a este mail (usa SMTP_*)
RUNPOD_ALERT_EMAIL=
