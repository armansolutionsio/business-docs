# URL de Arman Suite (business-docs). En desarrollo: http://localhost:3000
TASKPILOT_SERVER_URL=

# Token del runner: lo genera un admin en /taskpilot (panel Runners) y se muestra una sola vez.
TASKPILOT_RUNNER_TOKEN=

# Autenticacion de Claude (elegir UNA):
# - Vacio: el runner usa el login de Claude Code de esta PC (tu suscripcion Pro/Max). Hace falta
#   haber entrado con `claude` y /login en esta misma maquina. Uso individual: cada persona con su
#   propia cuenta en su propia PC.
# - Con valor: API key de Anthropic (console.anthropic.com > API Keys), se factura por token.
ANTHROPIC_API_KEY=

# Nombre con el que aparece el runner (por defecto, el nombre de la PC)
RUNNER_NAME=

# Archivo con los repos disponibles en esta PC (ver repos.example.json)
RUNNER_REPOS_FILE=./repos.json

# Carpeta de trabajo para tareas sin repositorio (consultas, analisis)
RUNNER_WORKDIR=./workspace

# Limites por turno de Claude: presupuesto en USD y cantidad maxima de pasos
RUNNER_MAX_BUDGET_USD=10
RUNNER_MAX_TURNS=80

# Esfuerzo de razonamiento (low | medium | high | xhigh | max). Vacio = el default del modelo.
RUNNER_EFFORT=
